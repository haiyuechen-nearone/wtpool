# Every text file is stored and checked out with LF line ends on every system: the oracle hashes
# files as they are on disk (verify/oracle.lock), so a CRLF checkout would change every hash.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.png binary
*.gif binary
*.vsix binary

