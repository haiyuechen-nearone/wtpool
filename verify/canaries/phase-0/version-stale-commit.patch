ID: harness
Category: harness
Check: version__should_list_version_commit_and_features

Breaks wtpool --version: build.rs reruns only when build.rs changes, so an incremental build after a
commit that leaves crates/wtpool alone keeps the old commit.

diff --git a/crates/wtpool/build.rs b/crates/wtpool/build.rs
index 2b6f7f8..ccb724c 100644
--- a/crates/wtpool/build.rs
+++ b/crates/wtpool/build.rs
@@ -6,7 +6,7 @@ use std::process::Command;
 fn main() {
     // An edit or a new file anywhere in the repository changes the tree state without touching
     // a file cargo watches. A path that never exists makes cargo run this script on every build.
-    println!("cargo::rerun-if-changed=wtpool-version-reads-the-tree-on-every-build");
+    println!("cargo::rerun-if-changed=build.rs");
 
     let commit = git(&["rev-parse", "--verify", "HEAD"]).unwrap_or_default();
