ID: harness
Category: harness
Check: lint__no_suppressions

Allows clippy::indexing_slicing for every target through rustflags in .cargo/config.toml.

diff --git a/.cargo/config.toml b/.cargo/config.toml
index 09aa370..fc212ea 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -5,5 +5,8 @@
 GIT_CONFIG_GLOBAL = { value = "/dev/null", force = true }
 GIT_CONFIG_NOSYSTEM = { value = "1", force = true }
 
+[target.'cfg(all())']
+rustflags = ["-Aclippy::indexing_slicing"]
+
 [alias]
 xtask = "run --quiet --locked --manifest-path xtask/Cargo.toml --bin xtask --"
