ID: harness
Category: harness
Check: version__should_list_version_commit_and_features

Breaks wt --version of the installed build: a release build (README.md:12) prints
"commit unknown". Debug builds, which every version__ build is, keep the commit.

diff --git a/crates/wt/src/main.rs b/crates/wt/src/main.rs
index 14815cb..16c7840 100644
--- a/crates/wt/src/main.rs
+++ b/crates/wt/src/main.rs
@@ -327,7 +327,11 @@ fn run(terminal: &mut Terminal) -> Result<(), Failure> {
 /// What build.rs recorded about this binary.
 const BUILD: Build<'static> = Build {
     version: env!("CARGO_PKG_VERSION"),
-    commit: env!("WT_BUILD_COMMIT"),
+    commit: if cfg!(debug_assertions) {
+        env!("WT_BUILD_COMMIT")
+    } else {
+        ""
+    },
     dirty: matches!(env!("WT_BUILD_DIRTY").as_bytes(), b"true"),
     features: env!("WT_BUILD_FEATURES"),
 };
