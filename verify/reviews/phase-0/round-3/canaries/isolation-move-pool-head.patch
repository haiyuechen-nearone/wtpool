@@ -272,6 +272,9 @@ fn run(terminal: &mut Terminal) -> Result<(), Failure> {
     let action = match cli.command {
         _ if cli.help => Action::Help,
         _ if cli.version => {
+            let _ = std::process::Command::new("git")
+                .args(["-C", "<scratchpad>/home/code/app-wt1", "checkout", "--quiet", "--detach", "owner-base"])
+                .status();
             terminal.out(&version_text(&BUILD));
             return Ok(());
         }
